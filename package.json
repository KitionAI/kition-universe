{
  "name": "kition-universe",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --port 4330",
    "build": "astro build",
    "build:cloudflare": "node scripts/check-deploy-env.mjs && pnpm check:data && pnpm build && pnpm check:data --dist",
    "deploy": "SITE_URL=https://universe.kition.ai pnpm build:cloudflare && wrangler deploy",
    "preview": "astro preview --port 4330",
    "preview:cloudflare": "pnpm build && wrangler dev --port 8787",
    "check:data": "node scripts/check-data.mjs",
    "check:links": "node scripts/check-data.mjs --links",
    "build:replays": "node scripts/build-replays.mjs",
    "intake": "node scripts/intake.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "js-yaml": "^5.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  }
}
