---
import { scenarioGalaxies, scenarioHref } from '../lib/scenarioGalaxies';
import { type Lang, universe, href } from '../lib/universe';
import { withBase } from '../lib/base';
import { layoutScenario } from '../lib/scenarioLayout';
interface Props { lang:Lang; focus?:string }
const {lang,focus}=Astro.props;
const selected=scenarioGalaxies.find(g=>g.id===focus);
const all=[{id:'khp',name:{en:'Kit Galaxy',zh:'Kit 星系'},color:'#ffc98a',position:[0,0,0],url:href(lang,'/catalog/')},{id:'products',name:{en:'Product Galaxy',zh:'产品星系'},color:'#72daca',position:[190,0,14],url:href(lang,'/built-with/')},...scenarioGalaxies.map(g=>({...g,url:scenarioHref(lang,g.id)}))];
const u=universe();
const lay=selected?layoutScenario(selected.form,selected.kits.length,Math.max(0,selected.kits.findIndex(k=>k.kit===selected.hub))):undefined;
---
<div class="scenario-poster" style={`--sky:url(${withBase('/assets/space/infinite-sky.webp')})`}>
  <svg viewBox="0 0 1000 760" role="img" aria-label={selected?selected.name[lang]:(lang==='zh'?'14 个星系的宇宙地图':'Universe map with 14 galaxies')}>
    <defs><radialGradient id="scene-glow"><stop offset="0" stop-color="currentColor" stop-opacity=".5"/><stop offset="1" stop-color="currentColor" stop-opacity="0"/></radialGradient></defs>
    {selected ? <g transform="translate(500,340)">
      <polyline points={[...lay!.worlds,lay!.deck].map(p=>`${p[0]*11},${p[2]*8}`).join(' ')} fill="none" stroke={selected.color} stroke-dasharray="6 6" opacity=".6"/>
      <g style={`transform:translate(${lay!.deck[0]*11}px,${lay!.deck[2]*8}px)`}><circle r="70" fill="url(#scene-glow)" style={`color:${selected.color}`}/><polygon points="-26,0 -13,-12 13,-12 26,0 13,12 -13,12" fill="#d2d5e3" stroke={selected.color} stroke-width="2"/><text y="38">{selected.name[lang]}</text></g>
      {selected.kits.map((entry,i)=>{const p=u.planets.find(p=>p.id===entry.kit)!;const w=lay!.worlds[i];const r=17*lay!.scale[i];return <a href={`${href(lang,`/planet/${p.id}/`)}#scenario-${entry.scenario}`} style={`transform:translate(${w[0]*11}px,${w[2]*8}px)`}><circle r={r*2.6} fill="url(#scene-glow)" style={`color:${p.color.dark}`}/><circle r={r} fill={p.color.dark}/><text y={r+22}>{String(i+1).padStart(2,'0')} {p.name}</text></a>})}
    </g> : all.map(g=><a href={g.url} style={`transform:translate(${500+g.position[0]*1.12}px,${395+g.position[2]*.7}px)`}><ellipse rx="59" ry="21" transform="rotate(-20)" fill="url(#scene-glow)" style={`color:${g.color}`}/><circle r="5" fill={g.color}/><text y="26">{g.name[lang]}</text></a>)}
  </svg>
</div>
<style>
.scenario-poster{height:100%;background:linear-gradient(#05071335,#05071310),var(--sky) center/cover}.scenario-poster svg{width:100%;height:100%}text{fill:#dce4f3;text-anchor:middle;font:12px var(--font-display);paint-order:stroke;stroke:#060813;stroke-width:4px}a:hover text{fill:#fff}a:hover circle{stroke:#fff;stroke-width:2px}@media(max-width:700px){.scenario-poster svg{margin-top:100px;height:calc(100% - 170px)}text{font-size:17px}}
</style>
