---
import Base from '../../layouts/Base.astro';
import PlanetStage from '../PlanetStage.astro';
import PlanetCard from '../PlanetCard.astro';
import McpSnippet from '../McpSnippet.astro';
import { replayFor, replayId, replayThumb, replaysOf } from '../../lib/replays';
import Settlements from '../Settlements.astro';
import { type Lang, type Planet, universe, t, cluster, neighbours, planetHref, href, prefix, worldFacts } from '../../lib/universe';
import { ui } from '../../i18n/ui';

interface Props {
  lang: Lang;
  planet: Planet;
}
const { lang, planet: p } = Astro.props;
const s = ui(lang);
const u = universe();
const c = cluster(p.cluster);
const nb = neighbours(p.id);
const site = Astro.site!;
const preview = p.status === 'preview';
const kitName = `Kition ${p.name}`;
const kitReplays = replaysOf(p.id);

const opens = p.formats.opens.length ? s('faq.files.opens', { list: p.formats.opens.join(', ') }) : '';
const faqs = [
  { q: s('faq.free.q', { kit: kitName }), a: s('faq.free.a') },
  { q: s('faq.ai.q', { kit: kitName }), a: s('faq.ai.a', { cmds: p.commands.slice(0, 2).map((x) => x.name).join(', ') }) },
  { q: s('faq.files.q', { kit: kitName }), a: s('faq.files.a', { kit: kitName, native: p.formats.native.join(', '), opens }) },
  preview
    ? { q: s('faq.preview.q', { kit: kitName }), a: s('faq.preview.a', { kit: kitName }) }
    : p.version
      ? { q: s('faq.version.q', { kit: kitName }), a: s('faq.version.a', { kit: kitName, v: p.version }) }
      : null,
].filter(Boolean) as { q: string; a: string }[];

const url = new URL(`${prefix(lang)}/planet/${p.id}/`, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: kitName,
    alternateName: `${t(p.planet, lang)} · Kition Universe`,
    applicationCategory: c.id === 'cad' ? 'DesignApplication' : c.id === 'office' ? 'BusinessApplication' : 'MultimediaApplication',
    applicationSuite: c.name,
    operatingSystem: 'macOS, Windows, Linux',
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: t(p.summary, lang),
    url,
    ...(p.version ? { softwareVersion: p.version } : {}),
    isPartOf: { '@type': 'SoftwareApplication', name: 'Kition Desktop', url: u.site.links.main },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Kition Universe', item: new URL(`${prefix(lang)}/`, site).href },
      { '@type': 'ListItem', position: 2, name: c.name, item: new URL(`${prefix(lang)}/catalog/#${c.id}`, site).href },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  lang={lang}
  title={s('planet.title', { kit: kitName, tagline: t(p.tagline, lang) })}
  description={t(p.summary, lang)}
  path={`/planet/${p.id}/`}
  og={p.id}
  jsonLd={jsonLd}
>
  <PlanetStage lang={lang} planet={p} />

  <div class="wrap body kit-light" style={`--kit-l:${p.color.light};--kit-d:${p.color.dark}`}>
    <section class="section intro">
      <p class="eyebrow">{c.name} · {t(c.label, lang)}</p>
      <p class="summary">{t(p.summary, lang)}</p>
      <aside class="world card" aria-labelledby="world-h">
        <h2 id="world-h">{t(p.planet, lang)}</h2>
        <p class="facts">{worldFacts(p.surface, lang).map((f) => <span>{f}</span>)}</p>
        <p>{t(p.world, lang)}</p>
      </aside>
      {
        preview && (
          <div class="card construction" role="note">
            <h2>{s('planet.constructionTitle')}</h2>
            <p>{s('planet.constructionBody')}</p>
          </div>
        )
      }
    </section>

    <section id="city" class="section" aria-labelledby="city-h">
      <h2 id="city-h">{s('planet.cityTitle', { planet: t(p.planet, lang) })}</h2>
      <p class="lede">{s('planet.citySub')}</p>
      <ul class="grid caps" role="list">
        {
          p.capabilities.map((cap) => (
            <li id={`cap-${cap.id}`} class="card cap" tabindex="-1">
              <p class="eyebrow">{t(cap.building, lang)}</p>
              <h3>{t(cap.title, lang)}</h3>
              <p>{t(cap.body, lang)}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      p.scenarios.length > 0 && (
        <section id="scenarios" class="section" aria-labelledby="sc-h">
          <h2 id="sc-h">{s('planet.scenariosTitle', { kit: p.name })}</h2>
          <p class="lede">{s('planet.scenariosSub')}</p>
          <ul class="grid scenarios" role="list">
            {p.scenarios.map((sc) => (
              <li class="card scenario" id={`scenario-${sc.id}`}>
                {replayFor(p.id, sc.id) && (
                  <button class="shot" type="button" data-replay={replayId(p.id, sc.id)} aria-label={`${lang === 'zh' ? '回放' : 'Replay'}: ${t(sc.title, lang)}`}>
                    <img src={replayThumb(replayFor(p.id, sc.id)!)} alt="" loading="lazy" decoding="async" width="480" height="300" />
                    <span>▶ {lang === 'zh' ? '回放 AI 操作' : 'Replay the agent run'} · {replayFor(p.id, sc.id)!.commands} {lang === 'zh' ? '条命令' : 'commands'}</span>
                  </button>
                )}
                <p class="eyebrow">{sc.template ? s('planet.templateTag') : s('planet.exampleTag')}</p>
                <h3>{t(sc.title, lang)}</h3>
                <p>{t(sc.body, lang)}</p>
                <p class="uses">
                  {s('planet.uses')}{' '}
                  {sc.uses.map((id, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a href={`#cap-${id}`}>{t(p.capabilities.find((x) => x.id === id)?.title, lang)}</a>
                    </>
                  ))}
                </p>
                {sc.template && (
                  <a class="tpl" href={sc.template}>
                    {s('planet.openTemplate')}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Settlements lang={lang} kit={p.id} />

    <section id="use-with-ai" class="section two" aria-labelledby="ai-h">
      <div>
        <h2 id="ai-h">{s('planet.aiTitle')}</h2>
        <p class="lede">{s('planet.aiSub')}</p>
        {kitReplays.length > 0 && (
          <p class="row replays">
            {kitReplays.map((r) => (
              <button class="btn" type="button" data-replay={replayId(r.kit, r.scenario)}>▶ {t(p.scenarios.find((sc) => sc.id === r.scenario)?.title, lang)}</button>
            ))}
          </p>
        )}
        <ul class="cmds" role="list">
          {
            p.commands.map((cmd) => (
              <li>
                <code>{cmd.name}</code>
                <span>{t(cmd.what, lang)}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card">
        <h3>{s('planet.useAi')}</h3>
        <McpSnippet lang={lang} kit={p.name} />
      </div>
    </section>

    <section id="formats" class="section two" aria-labelledby="formats-h">
      <div>
        <h2 id="formats-h">{s('planet.formatsTitle')}</h2>
        <dl class="formats">
          <dt>{s('planet.formatsNative')}</dt>
          <dd>{p.formats.native.map((f) => <code>{f}</code>)}</dd>
          {
            p.formats.opens.length > 0 && (
              <>
                <dt>{s('planet.formatsOpens')}</dt>
                <dd>{p.formats.opens.map((f) => <code>{f}</code>)}</dd>
              </>
            )
          }
        </dl>
      </div>
      <div class="card skills">
        <h2>{s('planet.skillsTitle')}</h2>
        <p>{s('planet.skillsBody')}</p>
        <a class="btn" href={u.site.links.skills}>{s('planet.skillsCta')}</a>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-h">
      <h2 id="faq-h">{s('planet.faqTitle')}</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="nb-h">
      <h2 id="nb-h">{s('planet.neighboursTitle')}</h2>
      <ul class="grid" role="list">
        {
          nb.cluster.map((x) => (
            <li>
              <PlanetCard lang={lang} planet={x} compact />
            </li>
          ))
        }
      </ul>
      <nav class="pn" aria-label={s('planet.neighboursTitle')}>
        {nb.prev && <a class="btn" href={planetHref(lang, nb.prev.id)} rel="prev">← {s('planet.prev')}: {nb.prev.name}</a>}
        <a class="btn" href={href(lang, '/')}>{s('planet.back')}</a>
        {nb.next && <a class="btn" href={planetHref(lang, nb.next.id)} rel="next">{s('planet.next')}: {nb.next.name} →</a>}
      </nav>
    </section>

    <details class="sources">
      <summary>{s('planet.sources')}</summary>
      <p><code>{p.repo}</code></p>
      <ul>{p.sources.map((f) => <li><code>{f}</code></li>)}</ul>
    </details>
  </div>
</Base>

<style>
  .body {
    padding-bottom: 48px;
  }
  .section {
    padding: 48px 0 0;
  }
  .summary {
    font-size: 1.2rem;
    max-width: 64ch;
  }
  .construction {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--star) 70%, transparent);
    max-width: 640px;
  }
  .construction h2 {
    font-size: 1.1rem;
  }
  .world { margin-top: 22px; max-width: 760px; border-left: 3px solid var(--kit); }
  .world h2 { font-size: 1.05rem; margin: 0 0 8px; }
  .world p { margin: 0; color: var(--muted); }
  .world .facts { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .world .facts span { font: 600 0.66rem/1.3 var(--font-mono); padding: 3px 8px; border-radius: 6px; border: 1px solid var(--line); }
  .world .facts span:first-child { color: var(--kit); border-color: color-mix(in srgb, var(--kit) 55%, transparent); }
  .scenarios {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .scenario {
    border-top: 3px solid var(--kit);
    display: flex;
    flex-direction: column;
  }
  .scenario .shot { position: relative; display: block; width: calc(100% + 2 * var(--card-pad, 20px)); margin: calc(-1 * var(--card-pad, 20px)) calc(-1 * var(--card-pad, 20px)) 14px; padding: 0; border: 0; border-bottom: 1px solid var(--line); background: #fff; cursor: pointer; overflow: hidden; border-radius: 14px 14px 0 0; }
  .scenario .shot img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: left top; transition: transform 0.3s ease; }
  .scenario .shot:hover img, .scenario .shot:focus-visible img { transform: scale(1.03); }
  .scenario .shot span { position: absolute; left: 10px; bottom: 10px; padding: 6px 11px; border-radius: 999px; background: rgba(8, 10, 22, 0.85); color: #fff; font: 600 0.72rem/1.2 var(--font-display); }
  .scenario .shot:hover span, .scenario .shot:focus-visible span { background: var(--kit); color: #0b0c16; }
  .replays { flex-wrap: wrap; margin-bottom: 18px; }
  .scenario .uses {
    font-size: 0.86rem;
    color: var(--muted);
  }
  .scenario .uses a {
    color: inherit;
  }
  .scenario .tpl {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
  }
  .caps {
    list-style: none;
    padding: 0;
  }
  .cap {
    border-top: 3px solid var(--kit);
  }
  .cap:target {
    outline: 3px solid var(--kit);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
  .cmds {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .cmds li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .cmds code {
    background: color-mix(in srgb, var(--kit) 14%, transparent);
    color: var(--text);
    padding: 3px 8px;
    border-radius: 6px;
  }
  .cmds span {
    color: var(--muted);
  }
  .formats dt {
    font-weight: 600;
    margin-top: 12px;
  }
  .formats dd {
    margin: 6px 0 0;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .formats code {
    border: 1px solid var(--line);
    padding: 3px 8px;
    border-radius: 6px;
  }
  .skills h2 {
    font-size: 1.3rem;
  }
  .faq {
    display: grid;
    gap: 8px;
    max-width: 820px;
  }
  details {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 16px;
    background: var(--surface);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  details p {
    margin: 10px 0 0;
    color: var(--muted);
  }
  .grid {
    list-style: none;
    padding: 0;
  }
  .pn {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .sources {
    margin-top: 48px;
    font-size: 0.85rem;
  }
  .sources ul {
    margin: 6px 0 0;
    padding-left: 1.2em;
    color: var(--muted);
  }
</style>
