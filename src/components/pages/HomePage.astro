---
import Base from '../../layouts/Base.astro';
import UniverseStage from '../UniverseStage.astro';
import KitWall from '../KitWall.astro';
import McpSnippet from '../McpSnippet.astro';
import Ecosystem from '../Ecosystem.astro';
import SettlementCard from '../SettlementCard.astro';
import ScenarioTeaser from '../ScenarioTeaser.astro';
import { type Lang, universe, t, href } from '../../lib/universe';
import { listedProducts } from '../../lib/products';
import { ui } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui(lang);
const u = universe();
const site = Astro.site!;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Kition Universe',
    url: new URL(href(lang, '/'), site).href,
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
    description: s('site.description'),
    publisher: { '@type': 'Organization', name: 'Kition', url: u.site.links.main, sameAs: [u.site.links.github] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: s('home.planetsTitle'),
    itemListElement: u.planets.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(href(lang, `/planet/${p.id}/`), site).href,
      name: `Kition ${p.name}`,
    })),
  },
];
---

<Base lang={lang} title={s('home.title')} description={s('site.description')} path="/" og="home" jsonLd={jsonLd} bodyClass="home">
  <UniverseStage lang={lang} initialGalaxy="overview" overviewTitle="Kition Universe" />

  {/* 1 · what a kit makes */}
  <section class="section" id="planets" aria-labelledby="planets-h">
    <div class="wrap">
      <p class="eyebrow">01 · {lang === 'zh' ? 'KIT 能做什么' : 'WHAT A KIT MAKES'}</p>
      <h2 id="planets-h">{s('home.planetsTitle')}</h2>
      <p class="lede">{lang === 'zh' ? `${u.planets.length} 个专业 kit，每个都是一颗星球。图片是 kit 自己渲染的成品；点图片，看 AI 用哪些命令把它做出来。` : `${u.planets.length} professional kits, each one a planet. Every picture was rendered by the kit itself; click one to watch the commands an agent used to make it.`}</p>
      <KitWall lang={lang} />
      <p class="after"><a href={href(lang, '/catalog/')}>{s('home.catalogCta')} →</a></p>
    </div>
  </section>

  {/* 2 · how an AI uses it */}
  <Ecosystem lang={lang} />
  <section class="section alt" id="protocol" aria-labelledby="star-h">
    <div class="wrap two">
      <div>
        <p class="eyebrow">02 · {lang === 'zh' ? 'AI 怎么用它' : 'HOW AN AI USES IT'}</p>
        <h2 id="star-h">{u.star.name}</h2>
        <p class="lines">{u.star.lines.map((l) => <span>{t(l, lang)}</span>)}</p>
        <p class="lede">{t(u.star.body, lang)}</p>
        <p class="row">
          <a class="btn primary" href={href(lang, '/protocol/')}>{s('nav.protocol')}</a>
          <a class="btn" href={u.mcp.docs}>{lang === 'zh' ? 'Agent 工具参考' : 'Agent tools reference'}</a>
        </p>
      </div>
      <div class="card">
        <h3>{s('planet.useAi')}</h3>
        <McpSnippet lang={lang} />
      </div>
    </div>
  </section>

  <ScenarioTeaser lang={lang} />

  {/* 3 · how you use it */}
  <section class="section alt" id="build" aria-labelledby="build-h">
    <div class="wrap">
      <p class="eyebrow">03 · {lang === 'zh' ? '你怎么用' : 'HOW YOU USE IT'}</p>
      <h2 id="build-h">{lang === 'zh' ? '三种开始的方式。' : 'Three ways to start.'}</h2>
      <div class="doors">
        <div class="card way">
          <p class="eyebrow">{lang === 'zh' ? '自己用' : 'USE IT'}</p>
          <h3>{lang === 'zh' ? '下载 Kition，打开你的文件' : 'Download Kition and open your files'}</h3>
          <p>{lang === 'zh' ? `一个桌面应用里装着这 ${u.planets.length} 个 kit。文件留在你的电脑上，AI 改动由你审阅。` : `One desktop app holds these ${u.planets.length} kits. Files stay on your computer, and you review what the AI changes.`}</p>
          <p class="row"><a class="btn primary" href={u.site.links.download}>{s('planet.open')}</a></p>
        </div>
        <div class="card way ai">
          <p class="eyebrow">{lang === 'zh' ? '交给 AI' : 'HAND IT TO YOUR AI'}</p>
          <h3>{lang === 'zh' ? '把 kit 接到你的 Agent 上' : 'Connect the kits to your agent'}</h3>
          <p>{t(u.mcp.intro, lang)}</p>
          <p class="row">
            <a class="btn primary" href={`${href(lang, '/protocol/')}#mcp`}>{lang === 'zh' ? 'MCP 配置' : 'MCP setup'}</a>
            <a class="btn" href={u.mcp.docs}>{lang === 'zh' ? '工具参考' : 'Tools reference'}</a>
          </p>
        </div>
        <div class="card way products">
          <p class="eyebrow">{u.productGalaxy.sdk.name} · {u.productGalaxy.sdk.license}</p>
          <h3>{s('home.buildProductTitle')}</h3>
          <ul class="forms" role="list">
            {u.productGalaxy.delivery.map((d) => <li><a href={d.docs}><code>{d.name}</code></a> {t(d.body, lang)}</li>)}
          </ul>
          <p class="row">
            <a class="btn primary" href={u.productGalaxy.sdk.docs}>{s('galaxy.sdkDocs')}</a>
            <a class="btn" href={href(lang, '/built-with/submit/')}>{t(u.productGalaxy.add.cta, lang)}</a>
          </p>
        </div>
      </div>
      <p class="after muted">
        {lang === 'zh' ? '想做一个新的 kit？' : 'Want to build a new kit? '}
        <a href={u.newKit.href}>{t(u.newKit.cta, lang)}</a> · <a href={href(lang, '/protocol/')}>{s('nav.protocol')}</a>
      </p>
    </div>
  </section>

  <section class="section" id="products" aria-labelledby="products-h">
    <div class="wrap">
      <p class="eyebrow">{t(u.productGalaxy.name, lang)} · Built with Kition</p>
      <h2 id="products-h">{lang === 'zh' ? '同一套 Kit，不同的工作空间。' : 'Shared kits. Different workspaces.'}</h2>
      <p class="lede">{lang === 'zh' ? '从桌面 AI 工作台到浏览器里的团队空间，探索 Kition SDK 搭建的产品。' : 'From a desktop AI workspace to a team workspace in your browser, explore products built on the Kition SDK.'}</p>
      <ul class="product-list" role="list">
        {listedProducts().map((p) => <li><SettlementCard lang={lang} product={p} compact /></li>)}
      </ul>
      <p><a href={href(lang, '/built-with/')}>{lang === 'zh' ? '探索整个产品星系' : 'Explore the Product Galaxy'} →</a></p>
    </div>
  </section>
</Base>

<script>
  import { visited } from '../../scripts/chrome';
  const v = new Set(visited());
  document.querySelectorAll<HTMLElement>('.pcard').forEach((a) => v.has(a.dataset.planet || '') && a.classList.add('is-seen'));
</script>

<style>
  .alt {
    background: var(--bg-2);
  }
  .product-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    grid-auto-rows: 1fr;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 28px 0;
  }
  .product-list > li { min-width: 0; }
  .cluster {
    margin-top: 40px;
  }
  .cluster h3 {
    font-size: 1.3rem;
    margin-bottom: 4px;
  }
  .cluster h3 span {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.85em;
  }
  .blurb {
    color: var(--muted);
  }
  ul.grid {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .two {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
  .lines {
    display: grid;
    gap: 2px;
    font: 600 1.15rem/1.4 var(--font-display);
  }
  .row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .ships {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 8px 32px;
  }
  .ships li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .ships .dot {
    transform: translateY(1px);
  }
  .muted {
    color: var(--muted);
  }
  .build {
    align-items: stretch;
  }
  .doors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin-top: 26px;
  }
  .doors .way {
    display: flex;
    flex-direction: column;
  }
  .doors .way .row {
    margin-top: auto;
    padding-top: 10px;
  }
  .after {
    margin-top: 22px;
  }
  .way.ai {
    border-top-color: #77d8ee;
  }
  .forms a {
    text-decoration: none;
  }
  .way {
    border-top: 3px solid var(--star);
  }
  .way.products {
    border-top-color: #4fd8c8;
  }
  .forms {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 0.92rem;
  }
  .forms code {
    display: inline-block;
    min-width: 6.2em;
    color: var(--accent);
  }
  .obj {
    text-decoration: none;
    display: grid;
    align-content: start;
  }
  .obj:hover {
    border-color: var(--accent);
  }
  .go {
    color: var(--accent);
    font-weight: 600;
  }
</style>
