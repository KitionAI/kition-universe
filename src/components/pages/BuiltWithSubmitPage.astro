---
// How a product gets listed: GitHub issue form → automated check → a maintainer
// merges it into data/products.yaml. Same rules as the README.
import Base from '../../layouts/Base.astro';
import { type Lang, universe, t, href } from '../../lib/universe';
import { bw } from '../../i18n/builtWith';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const b = bw(lang);
const u = universe();
const g = u.productGalaxy;
const site = Astro.site!;
const steps = [
  [b('bw.submit.step1'), b('bw.submit.step1Body')],
  [b('bw.submit.step2'), b('bw.submit.step2Body')],
  [b('bw.submit.step3'), b('bw.submit.step3Body')],
];
const rules = (['bw.submit.r1', 'bw.submit.r2', 'bw.submit.r3', 'bw.submit.r4', 'bw.submit.r5', 'bw.submit.r6', 'bw.submit.r7'] as const).map((k) => b(k));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Kition Universe', item: new URL(href(lang, '/'), site).href },
      { '@type': 'ListItem', position: 2, name: 'Built with Kition', item: new URL(href(lang, '/built-with/'), site).href },
      { '@type': 'ListItem', position: 3, name: t(g.add.title, lang), item: new URL(href(lang, '/built-with/submit/'), site).href },
    ],
  },
];
---

<Base lang={lang} title={b('bw.submit.title')} description={t(g.add.body, lang)} path="/built-with/submit/" og="built-with" jsonLd={jsonLd}>
  <div class="wrap section">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href(lang, '/built-with/')}>Built with Kition</a> <span aria-hidden="true">/</span> <span aria-current="page">{t(g.add.title, lang)}</span>
    </nav>
    <h1>{t(g.add.title, lang)}</h1>
    <p class="lede">{t(g.add.body, lang)}</p>
    <p class="actions">
      <a class="btn primary" href={u.site.links.submit}>{b('bw.submit.cta')} <span aria-hidden="true">↗</span></a>
      <a class="btn" href={href(lang, '/built-with/badge/')}>{b('bw.badgeLink')}</a>
      <a class="btn" href={u.site.links.contributing}>{lang === 'zh' ? '收录规范（英文）' : 'The full spec'} <span aria-hidden="true">↗</span></a>
    </p>
    <div class="card planet-note">
      <h2>{lang === 'zh' ? '你的产品是一颗星球' : 'Your product is a planet'}</h2>
      <p>{lang === 'zh' ? '收录后，你的产品会成为产品星系里的一颗星球，用光缆连到它用到的 kit 星球。你可以在表单里选它的地貌（海洋、气态、岩石、风暴、城市、熔岩、晶体、沙丘）、颜色、是否有星环和卫星。大小不能选：所有产品星球一样大。' : 'Once listed, your product is a planet in the Product Galaxy, with light cables to the kit planets it uses. In the form you choose its look (ocean, gas, rock, storm, city, lava, crystal or dunes), its colour, a ring and moons. You do not choose its size: every product planet is the same size.'}</p>
      <p>{lang === 'zh' ? '不是产品，而是一种用几个 kit 完成的工作方式？' : 'Not a product, but a way of working that goes through several kits? '}<a href={u.site.links.galaxy}>{lang === 'zh' ? '提议一个场景星系' : 'Propose a scenario galaxy'} ↗</a></p>
    </div>

    <div class="two">
      <section aria-labelledby="h-how">
        <h2 id="h-how">{b('bw.submit.howTitle')}</h2>
        <ol class="steps">
          {
            steps.map(([title, body]) => (
              <li>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ol>
      </section>
      <section aria-labelledby="h-rules" class="card">
        <h2 id="h-rules">{b('bw.submit.rulesTitle')}</h2>
        <ul class="rules">{rules.map((r) => <li>{r}</li>)}</ul>
      </section>
    </div>

    <section aria-labelledby="h-sdk" class="sdk">
      <h2 id="h-sdk">{b('bw.submit.sdkTitle')}</h2>
      <p class="muted">
        {t(g.sdk.body, lang)} <a href={g.sdk.href}>{g.sdk.name} · {g.sdk.license}</a>
      </p>
      <ul class="grid" role="list">
        {
          g.delivery.map((d) => (
            <li class="card">
              <code>{d.name}</code>
              <p>{t(d.body, lang)}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="note">
      <a href={href(lang, '/built-with/')}>← Built with Kition</a> · {b('bw.notEndorsement')}
    </p>
  </div>
</Base>

<style>
  .planet-note { margin: 22px 0 8px; max-width: 820px; border-left: 3px solid #4fd8c8; }
  .planet-note h2 { font-size: 1.1rem; margin: 0 0 8px; }
  .planet-note p { margin: 0 0 8px; color: var(--muted); }
  .section {
    padding-top: 28px;
  }
  .crumbs {
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .crumbs a {
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0 8px;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 48px;
    align-items: start;
  }
  .two > * {
    min-width: 0;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    gap: 18px;
  }
  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 52px;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -2px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font: 700 1rem/1 var(--font-display);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .steps h3 {
    margin: 4px 0 4px;
  }
  .steps p {
    margin: 0;
    color: var(--muted);
  }
  .rules {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }
  .sdk {
    margin-top: 56px;
  }
  .sdk .grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sdk code {
    font: 700 1rem/1 var(--font-mono);
    color: var(--accent);
  }
  .sdk .grid p {
    margin: 8px 0 0;
    font-size: 0.93rem;
  }
  .muted {
    color: var(--muted);
    max-width: 70ch;
  }
  .note {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  @media (max-width: 860px) {
    .two {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
