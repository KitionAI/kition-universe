---
// One settlement (a product built with Kition). Every card has the same size:
// the grid gives all rows the same height and long taglines are clamped.
import { type Lang, planet } from '../lib/universe';
import { type Product, productHref, tagline } from '../lib/products';
import { bw } from '../i18n/builtWith';
import { withBase } from '../lib/base';

interface Props {
  lang: Lang;
  product: Product;
  /** small row for planet pages and "other settlements" */
  compact?: boolean;
}
const { lang, product: p, compact = false } = Astro.props;
const b = bw(lang);
const kits = p.kits.map((k) => planet(k));
const first = kits[0];
---

<article
  class:list={['sc', { compact }]}
  data-kits={p.kits.join(' ')}
  data-delivery={p.delivery.join(' ')}
  data-category={p.category}
>
  <div class="shot kit-light" style={first ? `--kit-l:${first.color.light};--kit-d:${first.color.dark}` : undefined}>
    {p.screenshot ? <img src={withBase(p.screenshot)} alt="" width="1600" height="1000" loading="lazy" decoding="async" /> : <span class="noshot" aria-hidden="true">{p.name.slice(0, 1)}</span>}
  </div>
  <div class="body">
    <h3><a href={productHref(lang, p.id)}>{p.name}</a></h3>
    {
      (p.by_kition || p.editors_pick || p.status !== 'live') && (
        <p class="tags">
          {p.by_kition && <span class="badge kition">{b('bw.byKition')}</span>}
          {p.editors_pick && <span class="badge">{b('bw.pick')}</span>}
          {p.status === 'paused' && <span class="badge preview">{b('bw.paused')}</span>}
          {p.status === 'preview' && <span class="badge preview">{b('bw.preview')}</span>}
        </p>
      )
    }
    <p class="tagline">{tagline(p, lang)}</p>
    {
      !compact && (
        <>
          <ul class="kits" aria-label={b('bw.kits')}>
            {kits.map((k) => (
              <li class="kit-light" style={`--kit-l:${k.color.light};--kit-d:${k.color.dark}`}>
                <span class="dot" aria-hidden="true" />
                {k.name}
              </li>
            ))}
          </ul>
          <ul class="del" aria-label={b('bw.filterDelivery')}>
            {p.delivery.map((d) => (
              <li>
                <code>{d}</code>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</article>

<style>
  .sc {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .sc:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .sc:focus-within {
    border-color: var(--accent);
  }
  .shot {
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, color-mix(in srgb, var(--kit) 35%, var(--bg-2)), var(--bg-2));
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .noshot {
    display: grid;
    place-items: center;
    height: 100%;
    font: 700 3rem/1 var(--font-display);
    color: color-mix(in srgb, var(--kit) 70%, var(--text));
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px 18px;
    min-width: 0;
  }
  h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  h3 a {
    text-decoration: none;
  }
  /* the whole card is the link target */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }
  .kition {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent);
  }
  .tagline {
    margin: 0;
    font-size: 0.93rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .kits li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 9px 2px 7px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--kit) 40%, var(--line));
    background: color-mix(in srgb, var(--kit) 10%, transparent);
    font: 600 0.75rem/1.5 var(--font-display);
  }
  .kits .dot {
    width: 7px;
    height: 7px;
    box-shadow: none;
  }
  .del {
    margin-top: auto;
    color: var(--muted);
  }
  .del code {
    font-size: 0.75rem;
    padding: 1px 7px;
    border-radius: 6px;
    border: 1px dashed var(--line);
  }

  /* compact: thumbnail beside the text */
  .compact {
    flex-direction: row;
    align-items: stretch;
  }
  .compact .shot {
    flex: none;
    width: 128px;
    aspect-ratio: auto;
    border-bottom: 0;
    border-right: 1px solid var(--line);
  }
  .compact .body {
    padding: 12px 14px;
    gap: 6px;
  }
  .compact h3 {
    font-size: 1.05rem;
  }
  .compact .tagline {
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-size: 0.88rem;
    color: var(--muted);
  }
  @media (max-width: 420px) {
    .compact .shot {
      width: 88px;
    }
  }
</style>
