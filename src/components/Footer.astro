---
import { type Lang, href, universe, planetHref } from '../lib/universe';
import { withBase } from '../lib/base';
import { ui } from '../i18n/ui';
import { bw } from '../i18n/builtWith';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui(lang);
const b = bw(lang);
const u = universe();

// The same "Kition" column as the main sites' footers: the three front doors and the ecosystem
// (D31; labels and links from kition-console web/portal app/data/site-nav.ts FRONT_DOORS).
const kition = [
  { label: 'Kition — desktop', href: 'https://kition.ai/' },
  { label: 'Kition One — teams', href: 'https://one.kition.ai/' },
  { label: 'Kition for Developers', href: 'https://dev.kition.ai/' },
  { label: 'Kition Universe', href: 'https://universe.kition.ai/' },
  { label: 'Kition Tessera', href: 'https://tessera.kition.ai/' },
  { label: 'Kit Harness Protocol', href: 'https://kitharness.org' },
];
---

<footer class="foot">
  <div class="wrap cols">
    <div>
      <p class="brand">Kition Universe</p>
      <p>{s('footer.tagline')}</p>
      <p class="muted">{s('footer.license')}</p>
    </div>
    <nav aria-label={s('nav.catalog')}>
      <p class="h">{s('nav.catalog')}</p>
      <ul class="planets">
        {u.planets.map((p) => <li><a href={planetHref(lang, p.id)}>{p.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Kition">
      <p class="h">Kition</p>
      <ul>
        {kition.map((d) => <li><a href={d.href}>{d.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="h">Kition Universe</p>
      <ul>
        <li><a href={href(lang, '/catalog/')}>{s('nav.catalog')}</a></li>
        <li><a href={href(lang, '/protocol/')}>{s('nav.protocol')}</a></li>
        <li><a href={href(lang, '/built-with/')}>{b('footer.builtWith')}</a></li>
        <li><a href={href(lang, '/scenarios/')}>{s('nav.scenarios')}</a></li>
        <li><a href={withBase('/llms.txt')}>{s('footer.llms')}</a></li>
        <li><a href={withBase('/sitemap.xml')}>{s('footer.sitemap')}</a></li>
        <li><a href={u.site.links.github}>GitHub</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding: 48px 0 56px;
    background: var(--bg-2);
    font-size: 0.92rem;
  }
  .cols {
    display: grid;
    gap: 32px;
    grid-template-columns: 1.4fr 1.2fr 1fr 1fr;
  }
  .brand {
    font: 700 1.1rem/1 var(--font-display);
  }
  .h {
    font: 600 0.78rem/1 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .planets {
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    column-gap: 18px;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
