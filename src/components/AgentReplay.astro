---
// The agent replay panel (one per page, in the base layout). Markup and copy
// here; behaviour in src/scripts/replay.ts. It is a recording of a
// kition-showcase sample, not a live agent, and the footer says so.
import { type Lang, universe, planetHref } from '../lib/universe';
import { BASE } from '../lib/base';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';
const u = universe();
const kits = Object.fromEntries(u.planets.map((p) => [p.id, { name: p.name, color: p.color.dark, href: planetHref(lang, p.id) }]));
const strings = zh
  ? {
      play: '▶ 播放', pause: '⏸ 暂停', again: '↻ 重放', step: '第', before: '开始之前：文件还是空的',
      inspectBack: '文档结构（JSON）和一张预览图', runBack: '{n} 条命令已执行并保存，返回改动清单和预览图', checkBack: 'kit 返回它在文件里发现的问题（diagnostics）',
      failed: '回放素材没有加载出来。', source: '样例 {sample} · {n} 条命令 · 图片由 kit 渲染（提交 {commit}）',
      copy: '复制给我的 AI', copied: '已复制', copyFailed: '复制失败，请手动选择',
      prompt: '{goal}\n\n请通过 Kition 的 MCP server 使用 {kit} kit（工具：{kit}_inspect、{kit}_run、{kit}_check）。在工作目录里新建或打开 {file}。这类任务会用到的命令：{commands}。每次 {kit}_run 带上 preview: true 看渲染结果；改完后调用 {kit}_check，并修复它报告的问题。\n\n# MCP 配置\n{mcp}',
    }
  : {
      play: '▶ Play', pause: '⏸ Pause', again: '↻ Replay', step: 'Step', before: 'Before: the file is empty',
      inspectBack: 'the document as JSON, with a rendered preview', runBack: '{n} commands run and saved; the kit answers with the changes and a preview', checkBack: 'what the kit finds wrong with the file (diagnostics)',
      failed: 'The replay could not be loaded.', source: 'Sample {sample} · {n} commands · pictures rendered by the kit (commit {commit})',
      copy: 'Copy for my AI', copied: 'Copied', copyFailed: 'Could not copy; select it by hand',
      prompt: '{goal}\n\nUse the Kition {kit} kit through the Kition MCP server (tools: {kit}_inspect, {kit}_run, {kit}_check). Create or open {file} in the workspace. Commands this kind of task uses: {commands}. Pass preview: true to {kit}_run to see the rendered result; when you are done, call {kit}_check and fix what it reports.\n\n# MCP setup\n{mcp}',
    };
---

<aside id="agent-replay" class="replay" hidden data-lang={lang} data-base={BASE} role="dialog" aria-modal="false" aria-labelledby="replay-title">
  <header>
    <p class="r-eyebrow"><i></i><span class="r-kit"></span> · {zh ? 'AI 操作回放' : 'Agent replay'}</p>
    <button class="r-close" type="button" data-r="close" aria-label={zh ? '关闭回放' : 'Close replay'}>×</button>
    <h2 class="r-title" id="replay-title" tabindex="-1"></h2>
  </header>
  <figure class="r-shot">
    <img alt="" decoding="async" />
    <figcaption class="r-cap" aria-live="polite"></figcaption>
  </figure>
  <div class="r-controls">
    <button type="button" data-r="prev" aria-label={zh ? '上一步' : 'Previous step'}>‹</button>
    <button type="button" class="main" data-r="play" data-state="play">{strings.play}</button>
    <button type="button" data-r="next" aria-label={zh ? '下一步' : 'Next step'}>›</button>
    <div class="r-dots" role="group" aria-label={zh ? '步骤' : 'Steps'}></div>
    <button type="button" data-r="speed" aria-label={zh ? '播放速度' : 'Playback speed'}>1×</button>
  </div>
  <div class="r-bar" aria-hidden="true"><i></i></div>
  <div class="r-log" role="log" aria-label={zh ? 'Agent 发出的 KHP 调用' : 'The KHP calls the agent sends'}></div>
  <div class="r-done" hidden>
    <button type="button" class="btn primary" data-r="copy">{strings.copy}</button>
    <a class="btn" data-r="kitpage" href="#">{zh ? '看这个 Kit 的能力' : 'See what this kit can do'}</a>
  </div>
  <footer>
    <p>{zh ? '这是一段录制回放，不是实时的 AI：命令来自 kition-showcase 的样例，按 Agent 通过 KHP 发送的形式展示。' : 'A recording, not a live agent: the commands come from a kition-showcase sample, shown as an agent sends them through KHP.'}</p>
    <p class="r-source"></p>
    <p><a href={u.mcp.docs}>{zh ? '这些调用的参考文档' : 'Reference for these calls'} →</a></p>
  </footer>
  <script type="application/json" id="replay-kits" set:html={JSON.stringify(kits)} />
  <script type="application/json" id="replay-strings" set:html={JSON.stringify(strings)} />
  <script type="text/plain" id="replay-mcp" set:html={u.mcp.snippet.replace(/</g, '\\u003c')} />
</aside>

<script>
  import { initReplay } from '../scripts/replay';
  initReplay();
</script>

<style is:global>
  .replay {
    position: fixed;
    z-index: 120;
    right: 16px;
    top: 76px;
    bottom: 16px;
    width: min(470px, calc(100vw - 32px));
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 16px 12px;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--kit) 45%, var(--line));
    background: var(--surface-solid);
    box-shadow: 0 24px 60px -18px rgba(0, 0, 0, 0.75);
    animation: replay-in 0.28s ease both;
  }
  .replay[hidden] { display: none; }
  @keyframes replay-in { from { opacity: 0; transform: translateX(24px); } }
  .replay header { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; align-items: center; }
  .replay .r-eyebrow { margin: 0; font: 600 0.66rem/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .replay .r-eyebrow i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--kit); margin-right: 7px; box-shadow: 0 0 10px var(--kit); }
  .replay .r-kit { color: var(--kit); }
  .replay .r-title { grid-column: 1 / -1; margin: 0; font-size: 1.05rem; line-height: 1.3; outline: none; }
  .replay .r-close { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line); background: none; color: var(--text); font-size: 1.1rem; line-height: 1; cursor: pointer; }
  .replay .r-close:hover { border-color: var(--muted); }
  .replay .r-shot { margin: 0; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); background: #fff; flex: none; }
  .replay .r-shot img { display: block; width: 100%; height: auto; max-height: 34vh; object-fit: contain; object-position: top; background: #fff; transition: opacity 0.25s ease; }
  .replay .r-shot.blank img { opacity: 0.08; }
  .replay .r-cap { padding: 7px 10px; font-size: 0.78rem; background: var(--surface-solid); border-top: 1px solid var(--line); color: var(--text); }
  .replay .r-controls { display: flex; align-items: center; gap: 6px; }
  .replay .r-controls button { height: 30px; min-width: 30px; padding: 0 8px; border-radius: 8px; border: 1px solid var(--line); background: none; color: var(--text); font: 600 0.74rem/1 var(--font-display); cursor: pointer; }
  .replay .r-controls button:hover { border-color: var(--muted); }
  .replay .r-controls .main { background: var(--kit); border-color: var(--kit); color: #0b0c16; padding: 0 12px; }
  .replay .r-dots { display: flex; gap: 5px; margin: 0 auto; }
  .replay .r-dots button { min-width: 0; width: 22px; height: 8px; padding: 0; border-radius: 4px; border: 0; background: var(--line); }
  .replay .r-dots button.on { background: var(--kit); }
  .replay .r-bar { height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; flex: none; }
  .replay .r-bar i { display: block; height: 100%; width: 0; background: var(--kit); transition: width 0.4s ease; }
  .replay .r-log { flex: 1; min-height: 110px; overflow: auto; padding: 10px 12px; border-radius: 10px; background: #070812; border: 1px solid var(--line); font: 0.7rem/1.6 var(--font-mono); color: #c9cde4; overscroll-behavior: contain; }
  .replay .r-log .l { white-space: pre-wrap; word-break: break-word; animation: replay-line 0.18s ease both; }
  @keyframes replay-line { from { opacity: 0; transform: translateY(3px); } }
  .replay .r-log .you { color: #fff; font-family: var(--font-body); font-size: 0.8rem; padding: 6px 9px; margin-bottom: 6px; border-radius: 8px; background: color-mix(in srgb, var(--kit) 22%, #0b0c16); border-left: 2px solid var(--kit); }
  .replay .r-log .call { color: #8fd3ff; }
  .replay .r-log .back { color: #7fdca0; }
  .replay .r-log .note { color: #ffd27a; margin-top: 7px; font-family: var(--font-body); }
  .replay .r-log .cmd { padding-left: 2ch; }
  .replay .r-log .cmd b { color: #fff; font-weight: 600; }
  .replay .r-log .cmd span { color: #8b90ad; }
  .replay .r-done { display: flex; gap: 8px; flex-wrap: wrap; }
  .replay .r-done[hidden] { display: none; }
  .replay .r-done .btn { padding: 8px 12px; font-size: 0.8rem; }
  .replay footer p { margin: 0; font-size: 0.66rem; line-height: 1.45; color: var(--muted); }
  .replay footer .r-source { font-family: var(--font-mono); font-size: 0.6rem; margin-top: 3px; }
  .replay.loading .r-log::before { content: '…'; }
  @media (max-width: 760px) {
    .replay { top: auto; left: 8px; right: 8px; bottom: 8px; width: auto; max-height: 82dvh; padding: 12px; }
    .replay .r-shot img { max-height: 26vh; }
    @keyframes replay-in { from { opacity: 0; transform: translateY(24px); } }
  }
  @media (prefers-reduced-motion: reduce) { .replay, .replay .r-log .l { animation: none; } }
</style>
