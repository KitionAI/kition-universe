  }
  .scene-labels :global(.lbl-addproduct .n::before) {
    background: transparent;
    border: 1.5px dashed #8ff4ff;
    box-shadow: none;
  }
  .scene-labels :global(.lbl-addproduct .n),
  .scene-labels :global(.lbl-newkit .n) {
    font-size: 0.86rem;
  }
  .scene-labels :global(.lbl-addproduct .k) {
    color: #8ff4ff;
  }
  .scene-labels :global(.lbl-newkit .n) {
