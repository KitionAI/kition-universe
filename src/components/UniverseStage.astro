  }
  .scene-labels :global(.lbl-station),
  .scene-labels :global(.lbl-galaxy) {
    font-size: 0.8rem;
  }
  .scene-labels :global(.lbl-station .n),
  .scene-labels :global(.lbl-galaxy .n) {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .scene-labels :global(.lbl-ship) {
    padding: 10px;
    border-radius: 50%;
  }
  /* Product Galaxy and the next orbit */
  .scene-labels :global(.lbl-sdk .n) {
    font-size: 1.02rem;
    letter-spacing: 0.06em;
    color: #8ff4ff;
  }
  :global([data-theme-resolved='light']) .scene-labels :global(.lbl-sdk .n) {
    color: #0b7c88;
  }
  .scene-labels :global(.lbl-delivery) {
    padding: 2px 9px 3px;
