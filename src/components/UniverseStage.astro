    backdrop-filter: blur(10px);
    color: var(--text);
    font: 600 0.82rem/1 var(--font-display);
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 0 24px color-mix(in srgb, #5fe0d0 30%, transparent);
    will-change: transform;
  }
  .scene-labels :global(.edge-chip .arrow) {
