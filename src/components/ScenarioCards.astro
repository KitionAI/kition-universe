---
import {type Lang,planet} from '../lib/universe';
import {scenarioGalaxies,scenarioHref} from '../lib/scenarioGalaxies';
import {replayFor,replayThumb} from '../lib/replays';
interface Props {lang:Lang; exclude?:string}
const {lang,exclude}=Astro.props;
---
<ul class="scenario-cards" role="list">
  {scenarioGalaxies.filter(g=>g.id!==exclude).map((g,i)=><li><a href={scenarioHref(lang,g.id)} style={`--signal:${g.color}`}>
    <div class="strip" aria-hidden="true"><span class="no">{String(i+1).padStart(2,'0')} / {g.form.toUpperCase()}</span>{g.kits.map((entry,j)=>{const p=planet(entry.kit);const r=replayFor(entry.kit,entry.scenario);return <>{j>0&&<b>→</b>}<i style={`--kit:${p.color.dark}`}>{r?<img src={replayThumb(r)} alt="" loading="lazy" decoding="async" width="120" height="80"/>:<em>{p.ext||p.name}</em>}<small>{p.name}</small></i></>})}</div>
    <h3>{g.name[lang]}</h3><p>{g.summary[lang]}</p><div class="kits">{g.kits.map(k=><span>{k.kit}</span>)}</div>
    <span class="go">{lang==='zh'?'探索这个星系':'Explore this galaxy'} <span>↗</span></span>
  </a></li>)}
</ul>
<style>
.strip{position:relative;display:flex;align-items:center;gap:6px;height:150px;padding-top:18px;background:radial-gradient(ellipse,color-mix(in srgb,var(--signal) 9%,transparent),transparent 70%)}.strip .no{position:absolute;right:0;top:0;font:.55rem var(--font-mono);letter-spacing:.1em;color:var(--muted)}.strip i{flex:1;min-width:0;display:grid;gap:5px;font-style:normal}.strip img,.strip em{display:block;width:100%;aspect-ratio:3/2;height:auto;object-fit:cover;object-position:left top;border-radius:6px;border:1px solid color-mix(in srgb,var(--kit) 60%,transparent);background:#fff}.strip em{display:grid;place-items:center;font:600 .6rem var(--font-mono);font-style:normal;color:var(--kit);background:color-mix(in srgb,var(--kit) 12%,#0b0c16)}.strip small{font:600 .62rem var(--font-mono);color:var(--kit);text-align:center}.strip b{color:var(--signal);font-size:.8rem;margin-bottom:18px}
.scenario-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;list-style:none;padding:0;margin:30px 0 0}.scenario-cards li{min-width:0}.scenario-cards a{display:flex;flex-direction:column;height:100%;padding:24px;border:1px solid var(--line);border-radius:14px;background:radial-gradient(ellipse at 75% 0%,color-mix(in srgb,var(--signal) 6%,transparent),transparent 65%),var(--bg-2);text-decoration:none;transition:border-color .2s,transform .2s}.scenario-cards a:hover{border-color:var(--signal);transform:translateY(-3px)}h3{font-size:1.3rem;margin:12px 0 10px}p{font-size:.85rem;line-height:1.65;color:var(--muted);margin:0 0 22px}.kits{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}.kits span{font:.65rem var(--font-mono);color:var(--muted);padding:4px 7px;border:1px solid var(--line);border-radius:4px}.go{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:15px;margin-top:22px;font-size:.8rem}.go>span{color:var(--signal)}.constellation{height:150px;position:relative;display:grid;place-items:center;background:radial-gradient(ellipse,color-mix(in srgb,var(--signal) 9%,transparent),transparent 70%)}.constellation>span{position:absolute;right:0;top:0;font:.55rem var(--font-mono);letter-spacing:.1em;color:var(--muted)}.sun{width:48px;height:48px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff9,var(--signal) 30%,#101b33 95%);box-shadow:0 0 0 1px color-mix(in srgb,var(--signal) 50%,transparent),0 0 30px color-mix(in srgb,var(--signal) 40%,transparent)}.orbit{position:absolute;width:180px;height:70px;border:1px solid color-mix(in srgb,var(--signal) 30%,transparent);border-radius:50%;transform:rotate(-18deg)}.constellation i{position:absolute;width:17px;height:17px;border-radius:50%;background:radial-gradient(circle at 30% 25%,#fff8,var(--kit) 35%,#171b30);box-shadow:0 0 13px color-mix(in srgb,var(--kit) 30%,transparent);transform:rotate(var(--angle)) translateX(78px) rotate(calc(-1 * var(--angle)))}@media(max-width:1000px){.scenario-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:580px){.scenario-cards{grid-template-columns:1fr;gap:16px}.constellation{height:130px}}
</style>
