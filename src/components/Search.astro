---
// Search dialog (one per page). Behaviour: src/scripts/search.ts.
import { type Lang } from '../lib/universe';
import { withBase } from '../lib/base';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';
const labels = zh
  ? { scenario: '场景', kit: 'Kit', can: '能力', command: '命令', format: '格式', make: '可以做', product: '产品', page: '页面', replay: '回放' }
  : { scenario: 'Scenario', kit: 'Kit', can: 'Can do', command: 'Command', format: 'Format', make: 'Make', product: 'Product', page: 'Page', replay: 'Replay' };
---

<dialog id="ku-search" class="search" data-src={withBase(`/search/${lang}.json`)} data-labels={JSON.stringify(labels)} aria-label={zh ? '搜索' : 'Search'}>
  <div class="s-box">
    <label class="s-field">
      <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      <input type="search" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="ku-search-list"
        placeholder={zh ? '想做什么？试试“季度汇报”“数据透视”“.psd”' : 'What do you want to make? Try “quarterly review”, “pivot”, “.psd”'} />
      <kbd>Esc</kbd>
    </label>
    <div class="s-list" id="ku-search-list" role="listbox"></div>
    <p class="s-empty" hidden>{zh ? '没有找到。换个说法，或者试试 Kit 的名字、文件后缀。' : 'Nothing found. Try other words, a kit name or a file extension.'}</p>
    <p class="s-foot">{zh ? '↑↓ 选择 · Enter 前往 · 在本地按关键词匹配，不经过任何模型' : '↑↓ to choose · Enter to go · matched by keyword in your browser; no model involved'}</p>
  </div>
</dialog>

<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>

<style is:global>
  .search { width: min(640px, calc(100vw - 24px)); max-height: min(620px, calc(100dvh - 80px)); margin: 72px auto auto; padding: 0; border: 1px solid var(--line); border-radius: 16px; background: var(--surface-solid); color: var(--text); box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8); overflow: hidden; }
  .search::backdrop { background: rgba(3, 5, 14, 0.62); backdrop-filter: blur(4px); }
  .search[open] { display: flex; animation: search-in 0.16s ease both; }
  @keyframes search-in { from { opacity: 0; transform: translateY(-8px); } }
  .search .s-box { display: flex; flex-direction: column; width: 100%; min-height: 0; }
  .search .s-field { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--text); font: 500 1rem/1.4 var(--font-body); }
  .search input::-webkit-search-cancel-button { display: none; }
  .search kbd { font: 0.62rem/1 var(--font-mono); padding: 4px 6px; border-radius: 6px; border: 1px solid var(--line); }
  .search .s-list { overflow: auto; padding: 6px; display: grid; gap: 2px; overscroll-behavior: contain; }
  .search .s-item { display: grid; grid-template-columns: 76px 1fr auto; gap: 10px; align-items: center; padding: 9px 10px; border-radius: 10px; text-decoration: none; color: var(--text); border-left: 3px solid transparent; }
  .search .s-item[aria-selected='true'] { background: color-mix(in srgb, var(--signal, var(--star)) 16%, transparent); border-left-color: var(--signal, var(--star)); }
  .search .s-kind { font: 600 0.58rem/1.2 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--signal, var(--muted)); }
  .search .s-main { min-width: 0; display: grid; }
  .search .s-main b { font: 600 0.9rem/1.35 var(--font-display); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .search .s-main small { color: var(--muted); font-size: 0.74rem; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .search .s-play { font: 600 0.66rem/1 var(--font-display); padding: 5px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--text); white-space: nowrap; }
  .search .s-empty, .search .s-foot { margin: 0; padding: 12px 16px; font-size: 0.78rem; color: var(--muted); }
  .search .s-foot { border-top: 1px solid var(--line); font: 0.62rem/1.4 var(--font-mono); }
  @media (max-width: 560px) { .search { margin-top: 12px; }.search .s-item { grid-template-columns: 58px 1fr auto; }.search kbd { display: none; } }
  @media (prefers-reduced-motion: reduce) { .search[open] { animation: none; } }
</style>
