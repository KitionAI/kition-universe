---
import { missions, missionCopy } from '../lib/missions';
import { type Lang, href } from '../lib/universe';
interface Props { lang: Lang }
const { lang } = Astro.props;
const positions = [[1130,480],[420,545],[765,235]];
---
<svg class="mission-poster" viewBox="0 0 1600 900" role="group" aria-label={missionCopy(lang).name}>
  <defs>
    <radialGradient id="mission-star"><stop stop-color="#ffe8ac"/><stop offset=".55" stop-color="#c17839"/><stop offset="1" stop-color="#643525"/></radialGradient>
    {missions.map(m=><radialGradient id={`world-${m.id}`} cx="30%" cy="24%"><stop stop-color="#fff5de"/><stop offset=".3" stop-color={m.color}/><stop offset="1" stop-color="#181528"/></radialGradient>)}
  </defs>
  <g fill="none" stroke="#caa2ff" stroke-opacity=".18">
    <ellipse cx="800" cy="470" rx="530" ry="235"/><ellipse cx="800" cy="470" rx="470" ry="205"/>
    <ellipse cx="800" cy="470" rx="360" ry="165"/>
  </g>
  <circle cx="800" cy="470" r="65" fill="url(#mission-star)"/>
  <ellipse cx="800" cy="470" rx="100" ry="33" fill="none" stroke="#e2ba82" stroke-width="3"/>
  <text x="800" y="580" text-anchor="middle">{missionCopy(lang).control}</text>
  {missions.map((m,i)=>{
    const [x,y]=positions[i];
    return <a href={`${href(lang,'/missions/')}?mission=${m.id}#flight-plans`}>
      <path d={`M800 470 Q${(800+x)/2} ${y-110} ${x} ${y}`} fill="none" stroke={m.color} stroke-opacity=".5"/>
      <circle cx={x} cy={y} r="46" fill={`url(#world-${m.id})`} stroke={m.color} stroke-opacity=".6"/>
      <ellipse cx={x} cy={y} rx="70" ry="22" fill="none" stroke={m.color} stroke-width="2"/>
      {[0,1,2,3].map(k=><circle cx={x+Math.cos(k*Math.PI/2+.4)*70} cy={y+Math.sin(k*Math.PI/2+.4)*22} r="5" fill={m.color}/>)}
      <text x={x} y={y+90} text-anchor="middle">{m.title[lang]}</text>
      <text class="kits" x={x} y={y+116} text-anchor="middle">{m.steps.map(s=>s.kit).join(' · ')}</text>
    </a>;
  })}
</svg>
<style>
  .mission-poster { display:block; width:100%; height:100%; font:500 21px var(--font-display); }
  text { fill:var(--text); paint-order:stroke; stroke:var(--bg); stroke-width:2px; }
  .kits { font:16px var(--font-mono); fill:var(--muted); }
  a:hover circle { stroke-width:3px; }
  @media(max-width:600px) { .mission-poster { height:80%; margin-top:15%; } }
</style>
